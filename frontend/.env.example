# Keycloak OIDC settings for the Expo frontend.
# Copy to .env.local and keep the file out of source control.
EXPO_PUBLIC_AUTH_MODE=oidc
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8080/realms/sahai
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=sahai-api

# For a physical phone, replace localhost with the computer's LAN address.
# EXPO_PUBLIC_KEYCLOAK_ISSUER=http://192.168.1.7:8080/realms/sahai
