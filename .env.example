# Copy to .env for local Docker development. Never commit real values.
LDAP_ADMIN_PASSWORD=change-me-ldap-admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
SAHAI_AUTH_MODE=oidc
SAHAI_SECRET_KEY=replace-with-a-random-32-byte-secret
KEYCLOAK_ISSUER=http://localhost:8080/realms/sahai
KEYCLOAK_AUDIENCE=sahai-api

# Expo frontend OIDC settings (put these in frontend/.env.local)
# EXPO_PUBLIC_AUTH_MODE=oidc
# EXPO_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8080/realms/sahai
# EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=sahai-api
